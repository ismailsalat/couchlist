# --- Secrets -----------------------------------------------------------------
# Only .env.example is tracked.
.env
.env.*
!.env.example

# --- Runtime data ------------------------------------------------------------
# Root-anchored on purpose: a source folder named "logs" deeper in the tree
# should not be silently excluded.
/logs/
/exports/
/backups/
/pgdata/

# --- Databases ---------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.dump

# --- Node --------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- Build output ------------------------------------------------------------
dist/
.next/
out/
build/
*.tsbuildinfo

# --- Test output -------------------------------------------------------------
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# --- Editors -----------------------------------------------------------------
.vscode/
.idea/
*.swp

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
apps/web/next-env.d.ts

# Built by `npm run build:extension`, which runs as part of `npm run build`.
# Generated rather than committed so the download can never be older than the
# source it was built from.
apps/web/public/couchlist-reader-extension.zip
apps/web/public/extension-version.txt
