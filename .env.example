# =============================================================================
# Couchlist - example configuration
#
# Copy to .env and fill in. Never commit the real .env.
# =============================================================================

# --- Core --------------------------------------------------------------------

# development | test | staging | production
NODE_ENV=development
ENVIRONMENT=development

# Public URL of the web app. Used to build OAuth redirects and bot deep links.
# Must be https:// in production.
APP_BASE_URL=http://localhost:3000

# PostgreSQL. On Railway, reference the database service:
#   ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/couchlist

# Separate disposable database used only by npm test integration suites.
# Never point this at your production or Railway database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/couchlist_test

# --- Discord -----------------------------------------------------------------
# https://discord.com/developers/applications

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Used by the bot and by the web app's lightweight server-membership refresh.
DISCORD_BOT_TOKEN=

# Comma-separated Discord user IDs allowed to run bot-owner operations.
BOT_OWNER_IDS=

# --- Bot /about card ----------------------------------------------------------
# These only control what /about displays. Change them without touching code.
COUCHLIST_ABOUT_NAME=Couchlist
COUCHLIST_ABOUT_VERSION=12.7.0
COUCHLIST_ABOUT_DESCRIPTION=Track what your friends watch, share sources, and find something to watch together.
COUCHLIST_ABOUT_WEBSITE_URL=http://localhost:3000
COUCHLIST_ABOUT_SERVER_URL=https://discord.gg/qvGnUFn3VW
COUCHLIST_ABOUT_SERVER_NAME=Couchlist Community
COUCHLIST_ABOUT_CREATOR_NAME=Ismail
COUCHLIST_ABOUT_CREATOR_URL=
COUCHLIST_ABOUT_FOOTER=Good shows. Better company.

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Media providers ---------------------------------------------------------

# Anime providers. All three public catalog endpoints work without API keys.
# Couchlist fails over between them so one outage cannot blank the Anime tab.
ANILIST_API_URL=https://graphql.anilist.co
JIKAN_API_BASE_URL=https://api.jikan.moe/v4
KITSU_API_BASE_URL=https://kitsu.io/api/edge

# TMDB: https://www.themoviedb.org/settings/api
# Either a v3 API key or a v4 read access token works.
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# How long provider metadata is cached before it is fetched again.
MEDIA_CACHE_TTL_HOURS=24

# How long to wait on media providers before giving up (milliseconds).
PROVIDER_TIMEOUT_MS=8000

# --- Private testing ---------------------------------------------------------
# With TEST_MODE=true, only the listed accounts can sign in and the bot only
# responds in the listed servers. Everyone else sees a "private testing" page.

TEST_MODE=false
TEST_GUILD_IDS=
TEST_USER_IDS=

# --- Development login -------------------------------------------------------
# Signs in without Discord OAuth, for local work and Playwright.
# Startup refuses to boot if this is true with ENVIRONMENT=production or staging.

ALLOW_DEV_LOGIN=false

# --- Logging -----------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Structured JSON logs. Recommended in production.
LOG_JSON=false

# --- Rate limits (per user, per minute) --------------------------------------

RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_MUTATIONS_PER_MINUTE=30
RATE_LIMIT_BOT_COMMANDS_PER_MINUTE=20
