# =============================================================================
# Couchlist - example configuration
#
# Copy to .env and fill in. Never commit the real .env.
# =============================================================================

# --- Core --------------------------------------------------------------------

# development | test | staging | production
NODE_ENV=development
ENVIRONMENT=development

# Public URL of the web app. Used to build password-reset links and canonical
# URLs. Must be https:// in production.
APP_BASE_URL=http://localhost:3000

# PostgreSQL. On Railway, reference the database service:
#   ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/couchlist

# Separate disposable database used only by the integration suites.
# Never point this at your production or Railway database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/couchlist_test

# Signs session cookies. Generate with: openssl rand -base64 32
# Required. Must be at least 32 characters in production.
AUTH_SECRET=

# --- Email -------------------------------------------------------------------
# Verification codes and password resets need delivery. Without it nobody can
# finish signing up, so production refuses to start unconfigured.

# auto  : use the provider below (required in production)
# log   : print messages to the server log instead of sending them. The
#         verification code is also returned in the API response outside
#         production, so a local signup can be completed without a mailbox.
#         Rejected when ENVIRONMENT is production or staging.
MAIL_TRANSPORT=log

# https://resend.com - required when MAIL_TRANSPORT=auto in production.
RESEND_API_KEY=
# The From address, e.g. "Couchlist <hello@couchlist.app>"
MAIL_FROM=

# --- Administrators ----------------------------------------------------------
# Comma-separated email addresses that receive the administrator role the next
# time they sign in. This only bootstraps the first administrator: the role is
# a column on the account and every permission check reads that column on the
# server. To grant or revoke later:
#   npm run admin:grant -- someone@example.com
#   npm run admin:grant -- someone@example.com --revoke
ADMIN_EMAILS=

# --- Logging -----------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Structured JSON logs. Recommended in production.
LOG_JSON=false

# --- Rate limits -------------------------------------------------------------

# Per signed-in account, per minute.
RATE_LIMIT_MUTATIONS_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=30

# Per client address, per minute. These cover endpoints with no account yet.
# Raise them if your deployment sits behind a NAT or proxy where many real
# people share one address.
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Private testing ---------------------------------------------------------
# With TEST_MODE=true the app shows a private-testing banner.

TEST_MODE=false

# =============================================================================
# Retired settings
#
# Couchlist no longer signs people in with Discord, runs a Discord bot, or
# tracks individual titles, so the settings below are not read by the web app.
# They are listed so an existing deploy's variables are recognisable; they can
# be removed from your environment.
#
#   DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN, BOT_OWNER_IDS
#   TMDB_API_KEY, ANILIST_API_URL, JIKAN_API_BASE_URL, KITSU_API_BASE_URL
#   TEST_GUILD_IDS, TEST_USER_IDS, ALLOW_DEV_LOGIN
#   COUCHLIST_ABOUT_* (the bot's /about card)
#
# The source importer still reads the watch-source settings, and the columns
# behind these features are preserved in the database.
# =============================================================================
