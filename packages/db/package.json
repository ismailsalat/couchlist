{
  "name": "@couchlist/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "migrate": "tsx src/migrate.ts",
    "deploy": "tsx src/migrate.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "^8.13.1",
    "@couchlist/shared": "*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
