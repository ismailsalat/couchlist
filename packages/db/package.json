{
  "name": "@couchlist/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "migrate": "npm run build --silent && node dist/migrate.js",
    "deploy": "npm run build --silent && node dist/migrate.js",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "seed": "npm run build --silent && node dist/scripts/seed.js",
    "reset": "npm run build --silent && node dist/scripts/reset.js",
    "import:watch-sources": "npm run build --silent && node dist/scripts/import-watch-sources.js",
    "import:watch-availability": "npm run build --silent && node dist/scripts/import-watch-availability.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "^8.13.1",
    "@couchlist/shared": "*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
